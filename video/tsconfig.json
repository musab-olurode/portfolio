{
	"compilerOptions": {
		"target": "ES2023",
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true
	},
	"include": ["src", "public/sites/manifest.json"]
}
