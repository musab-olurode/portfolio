{
	"name": "musab-olurode-portfolio",
	"author": "Mus'ab Olurode",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"lint": "eslint .",
		"test": "vitest run",
		"e2e": "playwright test",
		"serve": "serve out -l 4173",
		"preview": "wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"screenshots": "node scripts/capture-screenshots.mjs",
		"resume:pdf": "npm run build && node scripts/build-resume-pdf.mjs && npm run build",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm test"
	},
	"dependencies": {
		"next": "^16.4.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@next/eslint-plugin-next": "^16.4.2",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.13.0",
		"jsdom": "^29.1.1",
		"postcss": "^8.5.30",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"serve": "^14.2.6",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.1"
	}
}
